# App
APP_NAME="家庭 AI 补货助手"
APP_BASE_URL="http://localhost:8000"
TIMEZONE="America/Los_Angeles"

# Storage
DATABASE_PATH="data/home_inventory.sqlite3"
USE_GOOGLE_SHEETS=false
ENABLE_GMAIL_ORDER_ANALYSIS=false
ENABLE_EMAIL_SUMMARY=false
DEFAULT_SHIPPING_ADDRESS="YOUR_DEFAULT_SHIPPING_ADDRESS"

# Gemini
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# OpenAI (optional; not needed for the default lightweight MVP)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"

# Retail search
RETAIL_SEARCH_MODE="search_urls"
